# Game title (menus, page title) and save namespace. APP_NAME is the single source of the name;
# APP_SLUG scopes the browser saves and settings (localStorage keys voxel.<APP_SLUG>.*).
APP_NAME="Voxel Game"
APP_SLUG=voxel-game

# Port of the Vite dev server (npm run dev) and of the production server (npm start).
WEB_PORT=5173
