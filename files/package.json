{
  "name": "app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "pixi.js": "8.21.0",
    "three": "0.186.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
